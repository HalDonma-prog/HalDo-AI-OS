/* =====================================
   HALDO AI OS BROWSER v1.1
   CLEAN FINAL STYLE
   PART 1/4
===================================== */


/* =====================================
   GLOBAL
===================================== */

* {

    box-sizing: border-box;
    margin: 0;
    padding: 0;

}


body {

    font-family:
    "Segoe UI",
    Arial,
    sans-serif;

    background:
    radial-gradient(
        circle at top,
        #12345c,
        #050914
    );

    color: #ffffff;

    min-height: 100vh;

    overflow-x: hidden;

}



/* =====================================
   BOOT SCREEN
===================================== */


#haldoBoot {

    position: fixed;

    inset: 0;

    background:

    radial-gradient(
        circle,
        #123c70,
        #02040a
    );

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    z-index: 9999;

    animation:
    bootFade 2.5s ease forwards;

}



.boot-logo img {

    width: 160px;

    height: 160px;

    object-fit: contain;

    filter:
    drop-shadow(
        0 0 30px #00aaff
    );

    animation:

    logoPulse 2s infinite;

}



#haldoBoot h1 {

    margin-top: 25px;

    font-size: 42px;

    letter-spacing: 2px;

}



#haldoBoot p {

    margin-top: 12px;

    opacity: .8;

}



.boot-line {

    width: 240px;

    height: 4px;

    margin-top: 30px;

    background:

    linear-gradient(
        90deg,
        transparent,
        #00bfff,
        transparent
    );

    animation:

    lineMove 2s infinite;

}





@keyframes logoPulse {


    0%,100% {

        transform:
        scale(1);

    }


    50% {

        transform:
        scale(1.08);

    }


}





@keyframes lineMove {


    from {

        opacity:.3;

    }


    to {

        opacity:1;

    }


}





@keyframes bootFade {


    0% {

        opacity:1;

    }


    90% {

        opacity:1;

    }


    100% {

        opacity:0;

        pointer-events:none;

    }


}









/* =====================================
   MAIN SYSTEM
===================================== */


#haldoSystem {

    min-height:100vh;

}









/* =====================================
   HEADER
===================================== */


.haldo-header {

    height:90px;

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:

    0 30px;


    background:

    rgba(
    255,255,255,.08
    );


    backdrop-filter:
    blur(15px);


    border-bottom:

    1px solid

    rgba(
    255,255,255,.15
    );


}



.brand-area {

    display:flex;

    align-items:center;

    gap:15px;

}



.header-logo {

    width:65px;

    height:65px;

    object-fit:contain;

    filter:

    drop-shadow(
    0 0 15px #00aaff
    );

}



.brand-area h1 {

    font-size:28px;

}



.brand-area p {

    opacity:.7;

}



.system-status {

    padding:

    10px 20px;


    border-radius:

    20px;


    background:

    rgba(
    0,255,150,.15
    );

}
/* =====================================
   HALDO AI OS BROWSER v1.1
   CLEAN FINAL STYLE
   PART 2/4
===================================== */



/* =====================================
   MAIN LAYOUT
===================================== */


.os-layout {

    display:flex;

    min-height:

    calc(100vh - 90px);

}





/* =====================================
   SIDEBAR
===================================== */


.left-sidebar {

    width:260px;

    padding:25px;

    background:

    rgba(
    255,255,255,.06
    );


    backdrop-filter:

    blur(18px);


    border-right:

    1px solid

    rgba(
    255,255,255,.12
    );


}





.sidebar-brand {

    display:flex;

    align-items:center;

    gap:12px;

    margin-bottom:30px;

}



.mini-logo {

    width:45px;

    height:45px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:50%;


    background:

    rgba(
    0,170,255,.25
    );


    font-size:24px;


}





.main-navigation {

    display:flex;

    flex-direction:column;

    gap:12px;

}





.nav-button {

    width:100%;

    padding:14px;

    border:none;

    border-radius:14px;


    background:

    rgba(
    255,255,255,.08
    );


    color:white;

    cursor:pointer;


    text-align:left;


    font-size:15px;


    transition:.3s;


}



.nav-button:hover {


    background:

    rgba(
    0,170,255,.35
    );


    transform:

    translateX(5px);


}



.nav-button.active {


    background:

    linear-gradient(

    135deg,

    #008cff,

    #0055aa

    );


}





.sidebar-bottom {


    margin-top:40px;


}





/* =====================================
   MAIN CONTENT
===================================== */


.main-content {

    flex:1;

    padding:30px;

}





.page {

    display:none;

    animation:

    fadePage .4s ease;


}



.page.active {

    display:block;


}




@keyframes fadePage {


    from {

        opacity:0;

        transform:
        translateY(15px);

    }


    to {

        opacity:1;

        transform:
        translateY(0);

    }


}









/* =====================================
   DASHBOARD
===================================== */


.welcome-card {


    padding:35px;


    border-radius:25px;


    background:

    rgba(
    255,255,255,.08
    );


    backdrop-filter:

    blur(20px);


    box-shadow:

    0 20px 50px

    rgba(
    0,0,0,.25
    );


}





.welcome-card h2 {


    font-size:32px;

    margin-bottom:10px;


}





.ai-message-start {


    margin-top:25px;

    padding:20px;


    border-radius:18px;


    background:

    rgba(
    0,170,255,.15
    );


}





.dashboard-grid {


    margin-top:30px;


    display:grid;


    grid-template-columns:

    repeat(
    auto-fit,
    minmax(220px,1fr)
    );


    gap:20px;


}







.dashboard-card {


    padding:25px;


    border-radius:20px;


    background:

    rgba(
    255,255,255,.09
    );


    border:

    1px solid

    rgba(
    255,255,255,.15
    );


    transition:.3s;


}



.dashboard-card:hover {


    transform:

    translateY(-8px);


    box-shadow:

    0 15px 40px

    rgba(
    0,170,255,.25
    );


}









/* =====================================
   CHAT DESIGN
===================================== */


.chat-container {


    height:450px;


    overflow-y:auto;


    padding:20px;


    border-radius:20px;


    background:

    rgba(
    0,0,0,.25
    );


}





.chat-input-area {


    margin-top:20px;


    display:flex;


    gap:10px;


}





.chat-input-area input {


    flex:1;


    padding:15px;


    border-radius:15px;


    border:none;


    outline:none;


}





.primary-button {


    padding:14px 22px;


    border:none;


    border-radius:15px;


    background:

    linear-gradient(

    135deg,

    #00aaff,

    #0066cc

    );


    color:white;


    cursor:pointer;


    transition:.3s;


}



.primary-button:hover {


    transform:

    scale(1.05);


}







.user-message {


    margin:10px 0;

    padding:15px;


    border-radius:15px;


    background:

    rgba(
    0,140,255,.25
    );


}



.ai-message {


    margin:10px 0;

    padding:15px;


    border-radius:15px;


    background:

    rgba(
    255,255,255,.12
    );


}
/* =====================================
   HALDO AI OS BROWSER v1.1
   CLEAN FINAL STYLE
   PART 3/4
===================================== */



/* =====================================
   APP CARDS
===================================== */


.app-card {

    margin-top:25px;

    padding:25px;

    border-radius:22px;


    background:

    rgba(
    255,255,255,.08
    );


    backdrop-filter:

    blur(15px);


    border:

    1px solid

    rgba(
    255,255,255,.12
    );


}





/* =====================================
   FILE SYSTEM
===================================== */


#fileUpload {


    width:100%;

    padding:15px;


    border-radius:15px;


    background:

    rgba(
    255,255,255,.1
    );


    color:white;


}



#fileList {


    margin-top:20px;


}



#fileList p {


    padding:12px;


    border-radius:12px;


    background:

    rgba(
    0,170,255,.15
    );


}









/* =====================================
   WRITING AREA
===================================== */


#wri​terText {


    width:100%;


    min-height:300px;


    padding:20px;


    resize:vertical;


    border:none;


    outline:none;


    border-radius:20px;


    background:

    rgba(
    0,0,0,.25
    );


    color:white;


    font-size:16px;


}





textarea {


    width:100%;


    min-height:150px;


    padding:18px;


    border-radius:18px;


    border:none;


    outline:none;


    resize:vertical;


    background:

    rgba(
    0,0,0,.25
    );


    color:white;


}









/* =====================================
   SETTINGS
===================================== */


.settings-card {


    display:grid;


    gap:20px;


}





.settings-box {


    padding:25px;


    border-radius:20px;


    background:

    rgba(
    255,255,255,.08
    );


}





.settings-box h3 {


    margin-bottom:15px;


}





.settings-box input,


.settings-box select {


    width:100%;


    padding:14px;


    border-radius:14px;


    border:none;


    margin-top:10px;


    background:

    rgba(
    0,0,0,.25
    );


    color:white;


}









/* =====================================
   DARK MODE
===================================== */


body.dark-mode {


    background:

    #02030a;


}



body.dark-mode .dashboard-card,


body.dark-mode .app-card,


body.dark-mode .settings-box {


    background:

    rgba(
    0,0,0,.45
    );


}









/* =====================================
   NOTIFICATION CENTER
===================================== */


.notification-center {


    position:fixed;


    right:25px;


    bottom:25px;


    width:300px;


    padding:20px;


    border-radius:20px;


    background:

    rgba(
    255,255,255,.1
    );


    backdrop-filter:

    blur(20px);


}









/* =====================================
   MOBILE / HUAWEI OPTIMIZATION
===================================== */


@media(max-width:900px){



.os-layout {


    flex-direction:column;


}



.left-sidebar {


    width:100%;


    display:flex;


    overflow-x:auto;


}



.main-navigation {


    flex-direction:row;


}



.nav-button {


    min-width:130px;


}



.main-content {


    padding:15px;


}



.haldo-header {


    padding:0 15px;


}



.brand-area h1 {


    font-size:20px;


}



.header-logo {


    width:50px;


    height:50px;


}



.dashboard-grid {


    grid-template-columns:

    1fr;


}



.chat-input-area {


    flex-direction:column;


}



}
/* =====================================
   HALDO AI OS BROWSER v1.1
   CLEAN FINAL STYLE
   PART 4/4 FINAL
===================================== */



/* =====================================
   FOOTER
===================================== */


.haldo-footer {


    margin-top:40px;


    padding:30px;


    text-align:center;


    background:


    rgba(
    255,255,255,.06
    );


    border-top:


    1px solid

    rgba(
    255,255,255,.12
    );


    backdrop-filter:


    blur(15px);


}



.footer-logo {


    font-size:22px;


    font-weight:bold;


    color:#00bfff;


    text-shadow:


    0 0 15px

    #00bfff;


}





.haldo-footer p {


    margin-top:10px;


    opacity:.7;


}









/* =====================================
   FUTURE MODULES
===================================== */


.future-grid {


    display:grid;


    grid-template-columns:


    repeat(
    auto-fit,
    minmax(220px,1fr)
    );


    gap:20px;


    margin-top:25px;


}





.future-card {


    padding:25px;


    border-radius:22px;


    background:


    rgba(
    255,255,255,.08
    );


    border:


    1px solid


    rgba(
    255,255,255,.12
    );


    transition:.35s;


}





.future-card:hover {


    transform:


    translateY(-10px);


    box-shadow:


    0 20px 40px


    rgba(
    0,170,255,.3
    );


}





.future-card span {


    font-size:40px;


}









/* =====================================
   PREMIUM GLOW EFFECTS
===================================== */


.primary-button,


.nav-button {


    position:relative;


    overflow:hidden;


}





.primary-button::after,


.nav-button::after {


    content:"";


    position:absolute;


    top:0;


    left:-100%;


    width:100%;


    height:100%;


    background:


    linear-gradient(

    120deg,

    transparent,

    rgba(255,255,255,.35),

    transparent

    );


    transition:.5s;


}





.primary-button:hover::after,


.nav-button:hover::after {


    left:100%;


}









/* =====================================
   SMOOTH SCROLL
===================================== */


html {


    scroll-behavior:

    smooth;


}









/* =====================================
   SYSTEM CONNECTION AREA
===================================== */


#systemConnection {


    display:none;


}









/* =====================================
   EXTRA POLISH
===================================== */


h2 {


    margin-bottom:20px;


}



p {


    line-height:1.6;


}





button {


    font-family:inherit;


}









/* =====================================
   FINAL RESPONSIVE FIX
===================================== */


@media(max-width:600px){


.boot-logo img {


    width:110px;


    height:110px;


}



#haldoBoot h1 {


    font-size:28px;


}



.system-status {


    display:none;


}



.left-sidebar {


    padding:15px;


}



.welcome-card {


    padding:20px;


}



}