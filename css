* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
}
body {
    height: 100vh;
    background:
        linear-gradient(
            135deg,
            #111827,
            #020617
        );
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}
.app {
    width: 100%;
    max-width: 900px;
    height: 95vh;
    background: #111827;
    display: flex;
    flex-direction: column;
    border-radius: 22px;
    overflow: hidden;
    box-shadow:
        0 20px 60px rgba(0,0,0,0.45);
}
/* HEADER */
.chat-header {
    height: 80px;
    padding: 15px 20px;
    background: #1f2937;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}
.logo {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: #2563eb;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:25px;
}
.brand h1 {
    color:white;
    font-size:22px;
}
.brand p {
    color:#9ca3af;
    font-size:13px;
}
#newChat {
    border:none;
    background:#374151;
    color:white;
    padding:10px 15px;
    border-radius:12px;
    cursor:pointer;
}
#newChat:hover {
    background:#4b5563;
}
/* CHAT BEREICH */
.chat-window {
    flex:1;
    padding:20px;
    overflow-y:auto;
}
.message {
    display:flex;
    gap:10px;
    margin-bottom:18px;
}
.message.ai {
    justify-content:flex-start;
}
.message.user {
    justify-content:flex-end;
}
.avatar {
    width:35px;
    height:35px;
    border-radius:50%;
    background:#2563eb;
    display:flex;
    justify-content:center;
    align-items:center;
}
.bubble {
    max-width:75%;
    padding:14px 17px;
    border-radius:18px;
    color:white;
    line-height:1.5;
}
.ai .bubble {
    background:#374151;
    border-bottom-left-radius:5px;
}
.user .bubble {
    background:#2563eb;
    border-bottom-right-radius:5px;
}
/* EINGABE */
.input-area {
    display:flex;
    gap:10px;
    padding:15px;
    background:#1f2937;
}
textarea {
    flex:1;
    resize:none;
    height:50px;
    padding:15px;
    border:none;
    outline:none;
    border-radius:15px;
    background:#374151;
    color:white;
    font-size:15px;
}
textarea::placeholder {
    color:#9ca3af;
}
.icon-button {
    width:50px;
    border:none;
    background:#374151;
    color:white;
    border-radius:15px;
    font-size:20px;
    cursor:pointer;
}
.send-button {
    width:55px;
    border:none;
    background:#2563eb;
    color:white;
    border-radius:15px;
    font-size:22px;
    cursor:pointer;
}
.send-button:hover {
    background:#1d4ed8;
}
/* MOBILE */
@media(max-width:600px){
    .app {
        height:100vh;
        border-radius:0;
    }
    .brand h1 {
        font-size:18px;
    }
    .bubble {
        max-width:85%;
    }
    #newChat {
        padding:8px 10px;
        font-size:12px;
    }
}
