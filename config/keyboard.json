{
  "version": "18.0.0",

  "keyboard": {
    "enabled": true,
    "name": "HalDo Keyboard",
    "defaultLayout": "de",
    "autoDetectLanguage": true,
    "rememberLastLayout": true,
    "showLayoutIndicator": true,
    "floatingKeyboard": true,
    "responsive": true
  },

  "layouts": [

    {
      "id": "de",
      "name": "Deutsch",
      "language": "de-DE",
      "direction": "ltr",
      "enabled": true,
      "type": "standard",
      "entry": "js/keyboard/german-keyboard.js"
    },

    {
      "id": "en",
      "name": "English",
      "language": "en-US",
      "direction": "ltr",
      "enabled": true,
      "type": "standard",
      "entry": "js/keyboard/english-keyboard.js"
    },

    {
      "id": "ku",
      "name": "Kurdî",
      "language": "ku",
      "direction": "ltr",
      "enabled": true,
      "type": "standard",
      "entry": "js/keyboard/kurdish-keyboard.js"
    },

    {
      "id": "ar",
      "name": "العربية",
      "language": "ar",
      "direction": "rtl",
      "enabled": true,
      "type": "standard",
      "entry": "js/keyboard/arabic-keyboard.js"
    },

    {
      "id": "ez",
      "name": "Êzîdî",
      "language": "x-ezidi",
      "direction": "ltr",
      "enabled": true,
      "type": "custom",
      "entry": "js/keyboard/ezidi-keyboard.js"
    }

  ],

  "ezidi": {

    "enabled": true,

    "name": "HalDo Êzîdî Keyboard",

    "language": "x-ezidi",

    "direction": "ltr",

    "description": "Eigenes HalDo-Tastaturlayout für Êzîdî-Schriftzeichen und sprachbezogene Eingabe.",

    "features": {
      "customCharacters": true,
      "specialCharacters": true,
      "longPressCharacters": true,
      "accentCharacters": true,
      "symbolLayer": true,
      "numberLayer": true,
      "emojiLayer": true,
      "voiceInput": true,
      "suggestions": true,
      "autocorrect": true
    },

    "layers": {
      "letters": true,
      "numbers": true,
      "symbols": true,
      "emoji": true
    },

    "customCharacters": [
      "𐕒",
      "𐕣",
      "𐕤",
      "𐕥",
      "𐕦",
      "𐕧",
      "𐕨",
      "𐕩",
      "𐕪",
      "𐕫"
    ],

    "specialCharacters": [
      "Ê",
      "ê",
      "Î",
      "î",
      "Ş",
      "ş",
      "Ç",
      "ç",
      "Ẋ",
      "ẋ"
    ]
  },

  "input": {

    "suggestions": {
      "enabled": true,
      "maximumSuggestions": 5,
      "personalized": true,
      "learnFromUser": false
    },

    "autocorrect": {
      "enabled": true,
      "languageAware": true,
      "allowUndo": true
    },

    "prediction": {
      "enabled": true,
      "contextAware": true
    },

    "voice": {
      "enabled": true,
      "requiresPermission": true,
      "continuousMode": false
    },

    "clipboard": {
      "enabled": true,
      "history": true,
      "maximumItems": 50
    }

  },

  "appearance": {

    "theme": "system",

    "size": {
      "small": 0.85,
      "normal": 1,
      "large": 1.15
    },

    "keySpacing": 4,

    "roundedKeys": true,

    "showSymbols": true,

    "showLabels": true,

    "animations": true,

    "reducedMotionSupport": true

  },

  "behavior": {

    "hapticFeedback": true,

    "soundFeedback": false,

    "doubleSpacePeriod": true,

    "shiftLock": true,

    "swipeTyping": true,

    "longPress": true,

    "languageSwitchGesture": true

  },

  "languageSwitch": {

    "enabled": true,

    "gesture": "swipe-space",

    "availableLayouts": [
      "de",
      "en",
      "ku",
      "ar",
      "ez"
    ]
  },

  "accessibility": {

    "enabled": true,

    "largeKeys": true,

    "highContrast": true,

    "screenReaderLabels": true,

    "reducedMotion": true
  }

}