  ],

  "animation": {

    "enabled": true,

    "global": {
      "speed": 1,
      "smooth": true,
      "easing": "ease-in-out"
    },

    "logo": {
      "enabled": true,

      "logoRotation": false,

      "orbit": {
        "enabled": true,
        "speed": 8,
        "direction": "clockwise",
        "continuous": true,
        "pauseOnReducedMotion": true
      },

      "glow": {
        "enabled": true,
        "pulse": true,
        "pulseSpeed": 2.5
      },

      "particles": {
        "enabled": true,
        "amount": 24,
        "speed": 1,
        "orbiting": true
      },

      "speech": {
        "enabled": true,
        "audioReactive": true,
        "idleAnimation": true,
        "listeningAnimation": true,
        "thinkingAnimation": true,
        "speakingAnimation": true
      }
    },

    "interface": {
      "pageTransitions": true,
      "appTransitions": true,
      "modalTransitions": true,
      "notificationAnimations": true,
      "buttonAnimations": true
    }

  },

  "accessibility": {

    "reducedMotion": {
      "enabled": true,

      "behavior": {
        "disableParticles": true,
        "disableOrbit": true,
        "disableLargeTransitions": true,
        "reduceGlow": true,
        "keepEssentialFeedback": true
      }
    },

    "highContrast": {
      "enabled": true
    },

    "largeText": {
      "enabled": true,
      "scale": 1.15
    }
  },

  "customization": {

    "allowBackgroundChange": true,
    "allowAccentChange": true,
    "allowGlowChange": true,
    "allowOrbitChange": true,
    "allowParticleChange": true,
    "allowAnimationSpeedChange": true,

    "logo": {
      "allowGlowCustomization": true,
      "allowOrbitCustomization": true,
      "allowParticleCustomization": true,
      "allowAnimationSpeedCustomization": true,

      "allowLogoRotation": false
    }
  }

}