{
  "system": {
    "name": "HalDo AI OS",
    "displayName": "HalDo AI OS 18",
    "version": "18.0.0",
    "edition": "Professional Ultimate Foundation",
    "codename": "HalDo",
    "environment": "production",
    "language": "de-DE",
    "timezone": "Europe/Berlin"
  },

  "boot": {
    "enabled": true,
    "showLogoIntro": true,
    "showWelcome": true,
    "minimumDisplayTime": 4200,
    "allowSkip": true,
    "transitionToShell": true
  },

  "ui": {
    "defaultTheme": "dark",
    "responsive": true,
    "mobileSupport": true,
    "tabletSupport": true,
    "desktopSupport": true,
    "animations": true,
    "reducedMotionSupport": true,
    "safeAreaSupport": true
  },

  "logo": {
    "enabled": true,
    "source": "assets/logo/logo.png",
    "fallback": "assets/logo/logo-fallback.svg",

    "animation": {
      "enabled": true,
      "logoRotation": false,
      "orbitEnabled": true,
      "glowEnabled": true,
      "particlesEnabled": true,
      "pulseEnabled": true,
      "speechAnimationEnabled": true
    },

    "orbit": {
      "enabled": true,
      "speed": 8,
      "size": 1,
      "angle": -18,
      "energyEffect": true,
      "planetEffect": true
    },

    "glow": {
      "enabled": true,
      "strength": 1,
      "pulse": true
    },

    "particles": {
      "enabled": true,
      "amount": 24
    },

    "speech": {
      "enabled": true,
      "intensity": 0.7,
      "audioReactive": true
    }
  },

  "ai": {
    "enabled": true,
    "assistantName": "HalDo AI",
    "chatEnabled": true,
    "memoryEnabled": true,
    "contextEnabled": true,
    "toolsEnabled": true,
    "voiceEnabled": true,
    "speechRecognitionEnabled": true,
    "speechSynthesisEnabled": true,
    "provider": "local",
    "model": "default"
  },

  "keyboard": {
    "enabled": true,
    "defaultLayout": "de",

    "layouts": {
      "german": true,
      "english": true,
      "kurdish": true,
      "arabic": true,
      "ezidi": true
    },

    "features": {
      "emoji": true,
      "symbols": true,
      "voiceInput": true,
      "autocorrect": true,
      "suggestions": true,
      "customLayouts": true
    }
  },

  "apps": {
    "enabled": true,
    "allowInstall": true,
    "allowUninstall": true,
    "allowUpdates": true,
    "allowPermissions": true
  },

  "storage": {
    "enabled": true,
    "localStorage": true,
    "indexedDB": true,
    "cache": true,
    "temporaryFiles": true,
    "backup": true,
    "restore": true
  },

  "network": {
    "enabled": true,
    "onlineDetection": true,
    "apiAccess": true,
    "requestTimeout": 30000,
    "retryAttempts": 3
  },

  "security": {
    "enabled": true,
    "permissionManager": true,
    "sessionManager": true,
    "secureStorage": true,
    "securityLogs": true
  },

  "notifications": {
    "enabled": true,
    "systemNotifications": true,
    "appNotifications": true,
    "aiNotifications": true
  },

  "updates": {
    "enabled": true,
    "automaticChecks": true,
    "allowManualUpdate": true,
    "backupBeforeUpdate": true,
    "rollbackEnabled": true
  },

  "plugins": {
    "enabled": true,
    "allowInstall": true,
    "allowDisable": true,
    "allowRemove": true
  },

  "developer": {
    "enabled": true,
    "developerMode": false,
    "console": true,
    "debugger": true,
    "diagnostics": true,
    "testRunner": true
  },

  "accessibility": {
    "enabled": true,
    "reducedMotion": true,
    "largeText": true,
    "highContrast": true,
    "keyboardNavigation": true,
    "screenReaderSupport": true
  },

  "logging": {
    "enabled": true,
    "level": "info",
    "console": true,
    "persistent": true,
    "maximumEntries": 5000
  },

  "testing": {
    "enabled": true,
    "startupTest": true,
    "moduleTest": true,
    "appTest": true,
    "integrationTest": true
  }
}