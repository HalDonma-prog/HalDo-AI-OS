/* =====================================
   HALDO AI OS 7.0 STABLE
   MAIN DESIGN SYSTEM
===================================== */


/* RESET */

* {

    margin:0;
    padding:0;
    box-sizing:border-box;

}



:root {

    --blue:#00aaff;
    --dark:#020617;
    --card:rgba(255,255,255,0.10);
    --border:rgba(255,255,255,0.20);
    --text:white;

}





html {

    scroll-behavior:smooth;

}




body {

    min-height:100vh;

    font-family:
    "Segoe UI",
    Arial,
    sans-serif;

    background:

    radial-gradient(
        circle at top,
        #075985,
        #020617 70%
    );


    color:var(--text);

}





/* =====================================
   BOOT SCREEN
===================================== */


#boot-screen {


    position:fixed;

    inset:0;

    z-index:9999;


    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;


    background:

    radial-gradient(
        circle,
        #0284c7,
        #020617
    );


}




.boot-logo {


    font-size:90px;


    animation:

    pulse 2s infinite;


}





@keyframes pulse {


    50% {

        transform:scale(1.15);

    }


}





.hidden {

    display:none !important;

}





/* =====================================
   HEADER
===================================== */


.header {


    text-align:center;

    padding:30px;


    background:

    rgba(255,255,255,.08);


    backdrop-filter:

    blur(20px);


    border-bottom:

    1px solid var(--border);


}




.header h1 {


    font-size:34px;


}




.header p {


    opacity:.8;


}





/* =====================================
   NAVIGATION
===================================== */


.navigation {


    display:flex;


    justify-content:center;


    flex-wrap:wrap;


    gap:15px;


    padding:20px;


}





.navigation button {


    padding:15px 25px;


    border:none;


    border-radius:20px;


    cursor:pointer;


    color:white;


    background:

    rgba(0,170,255,.25);


    font-size:16px;


    transition:.3s;


}





.navigation button:hover {


    background:

    var(--blue);


    transform:

    translateY(-3px);


}





/* =====================================
   CONTENT
===================================== */


main {


    padding:25px;


}





.page {


    animation:

    fade .4s ease;


}





@keyframes fade {


    from {

        opacity:0;

        transform:translateY(20px);

    }


    to {

        opacity:1;

        transform:translateY(0);

    }


}







/* =====================================
   CARDS
===================================== */


.card {


    margin-top:20px;


    padding:25px;


    border-radius:25px;


    background:

    var(--card);


    border:

    1px solid var(--border);


    backdrop-filter:

    blur(20px);


}





.card p {


    margin:12px 0;


}







/* =====================================
   INPUTS
===================================== */


input,
textarea {


    width:100%;


    margin-top:15px;


    padding:15px;


    border:none;


    border-radius:15px;


    background:

    rgba(0,0,0,.35);


    color:white;


    font-size:16px;


}





textarea {


    min-height:150px;


}







button {


    margin-top:15px;


    padding:14px 25px;


    border:none;


    border-radius:15px;


    background:

    linear-gradient(
        135deg,
        #00aaff,
        #0055aa
    );


    color:white;


    cursor:pointer;


    font-size:16px;


}





button:hover {


    box-shadow:

    0 0 20px rgba(0,170,255,.5);


}







/* =====================================
   STATUS
===================================== */


.online {


    color:#00ff99;


    font-weight:bold;


}






/* =====================================
   FOOTER
===================================== */


footer {


    text-align:center;


    padding:30px;


    opacity:.7;


}





/* =====================================
   MOBILE
===================================== */


@media(max-width:768px){



.navigation {


    flex-direction:column;


    align-items:center;


}



.navigation button {


    width:90%;


}



main {


    padding:15px;


}



.header h1 {


    font-size:26px;


}



}






@media(max-width:480px){


body {

    font-size:15px;

}



button {


    width:100%;

}


}




/* =====================================
   END HALDO AI OS 7.0 CSS
===================================== */