/* RESET */

* {

    margin:0;
    padding:0;
    box-sizing:border-box;

}



/* ROOT */

:root {

    --primary:#00aaff;
    --secondary:#0055aa;
    --background:#020617;
    --card:rgba(255,255,255,0.08);
    --border:rgba(255,255,255,0.15);
    --text:#ffffff;
    --success:#00ff99;

}





/* BODY */

body {

    min-height:100vh;

    font-family:

    "Segoe UI",
    Arial,
    sans-serif;


    background:

    radial-gradient(
        circle at top,
        #075985,
        var(--background)
    );


    color:var(--text);

}





/* MAIN APP */

#app {

    min-height:100vh;

    display:flex;

    flex-direction:column;

}





/* HEADER */

.system-header {

    text-align:center;

    padding:40px 20px;


    background:

    rgba(255,255,255,0.08);


    backdrop-filter:

    blur(20px);


    border-bottom:

    1px solid var(--border);

}




.logo {

    font-size:70px;

    margin-bottom:15px;


    animation:

    float 3s infinite ease-in-out;

}





@keyframes float {


    50% {

        transform:translateY(-10px);

    }


}





.system-header h1 {

    font-size:34px;

}





.system-header p {

    margin-top:10px;

    opacity:.8;

}





/* CONTENT */

.main-container {

    flex:1;

    padding:25px;

    max-width:1100px;

    width:100%;

    margin:auto;

}





/* CARDS */

.welcome-card,
.modules-card {


    background:

    var(--card);


    border:

    1px solid var(--border);


    border-radius:25px;


    padding:25px;


    margin-bottom:25px;


    backdrop-filter:

    blur(20px);

}





h2 {

    margin-bottom:15px;

}





.status {

    color:

    var(--success);


    font-weight:bold;

}





/* MODULE GRID */

.module-grid {

    display:grid;


    grid-template-columns:

    repeat(
        auto-fit,
        minmax(200px,1fr)
    );


    gap:20px;

}





.module {


    background:

    rgba(0,170,255,.15);


    border-radius:20px;


    padding:20px;


    text-align:center;


    transition:.3s;

}





.module:hover {


    transform:

    translateY(-5px);


    box-shadow:

    0 0 25px rgba(0,170,255,.4);

}





.module h3 {


    margin:10px 0;


}





/* FOOTER */

.system-footer {


    text-align:center;


    padding:25px;


    opacity:.7;

}





/* MOBILE OPTIMIZATION */

@media(max-width:768px){


    .system-header h1 {

        font-size:26px;

    }



    .logo {

        font-size:55px;

    }



    .main-container {

        padding:15px;

    }


}





@media(max-width:480px){


    body {

        font-size:15px;

    }


}