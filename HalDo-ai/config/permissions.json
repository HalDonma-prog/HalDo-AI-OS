{
  "version": "18.0.0",

  "permissionSystem": {
    "enabled": true,
    "defaultPolicy": "ask",
    "rememberDecisions": true,
    "allowRevoke": true,
    "allowReset": true,
    "logDecisions": true
  },

  "permissions": [

    {
      "id": "storage",
      "name": "Speicher",
      "description": "Zugriff auf den von HalDo freigegebenen Datenspeicher.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "secure-storage",
      "name": "Sicherer Speicher",
      "description": "Zugriff auf geschützte Daten im sicheren Speicher.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "network",
      "name": "Netzwerk",
      "description": "Verwendung von Netzwerk- und Internetverbindungen.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "camera",
      "name": "Kamera",
      "description": "Zugriff auf die Kamera des Geräts.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "microphone",
      "name": "Mikrofon",
      "description": "Aufnahme von Audiodaten über das Mikrofon.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "audio",
      "name": "Audio",
      "description": "Wiedergabe und Verarbeitung von Audiodaten.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "location",
      "name": "Standort",
      "description": "Zugriff auf Standortinformationen.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "notifications",
      "name": "Benachrichtigungen",
      "description": "Anzeigen von System- und App-Benachrichtigungen.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "clipboard-read",
      "name": "Zwischenablage lesen",
      "description": "Lesen von Daten aus der Zwischenablage.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "clipboard-write",
      "name": "Zwischenablage schreiben",
      "description": "Schreiben von Daten in die Zwischenablage.",
      "risk": "normal",
      "default": "allow"
    },

    {
      "id": "files-read",
      "name": "Dateien lesen",
      "description": "Lesen vom Benutzer freigegebener Dateien.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "files-write",
      "name": "Dateien schreiben",
      "description": "Erstellen oder Ändern freigegebener Dateien.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "ai",
      "name": "HalDo AI",
      "description": "Verwendung der HalDo-AI-Funktionen.",
      "risk": "normal",
      "default": "allow"
    },

    {
      "id": "ai-memory",
      "name": "AI Memory",
      "description": "Speichern und Abrufen von AI-Kontext und Erinnerungen.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "voice",
      "name": "Sprachfunktionen",
      "description": "Verwendung von Sprachfunktionen.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "speech-recognition",
      "name": "Spracherkennung",
      "description": "Umwandlung gesprochener Sprache in Text.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "speech-synthesis",
      "name": "Sprachausgabe",
      "description": "Ausgabe von Sprache durch HalDo AI.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "keyboard",
      "name": "Tastatur",
      "description": "Verwendung der HalDo-Tastatur.",
      "risk": "normal",
      "default": "allow"
    },

    {
      "id": "keyboard-custom-layout",
      "name": "Eigene Tastaturlayouts",
      "description": "Verwendung benutzerdefinierter Tastaturlayouts.",
      "risk": "normal",
      "default": "ask"
    },

    {
      "id": "background",
      "name": "Hintergrunddienst",
      "description": "Ausführung unterstützter Aufgaben im Hintergrund.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "system-settings",
      "name": "Systemeinstellungen",
      "description": "Ändern von HalDo-Systemeinstellungen.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "app-management",
      "name": "App-Verwaltung",
      "description": "Installieren, Entfernen oder Verwalten von Apps.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "plugin-management",
      "name": "Plugin-Verwaltung",
      "description": "Installieren und Verwalten von Erweiterungen.",
      "risk": "high",
      "default": "ask"
    },

    {
      "id": "developer",
      "name": "Entwicklerzugriff",
      "description": "Zugriff auf Entwickler- und Debugging-Funktionen.",
      "risk": "critical",
      "default": "deny"
    },

    {
      "id": "system-diagnostics",
      "name": "Systemdiagnose",
      "description": "Ausführen von Diagnose- und Testfunktionen.",
      "risk": "high",
      "default": "ask"
    }

  ],

  "systemApps": {

    "haldo-ai": [
      "ai",
      "ai-memory",
      "storage",
      "network",
      "microphone",
      "speech-recognition",
      "speech-synthesis",
      "notifications"
    ],

    "settings": [
      "storage",
      "system-settings",
      "notifications"
    ],

    "security-center": [
      "storage",
      "secure-storage",
      "system-diagnostics",
      "system-settings"
    ],

    "system-monitor": [
      "system-diagnostics"
    ],

    "keyboard": [
      "keyboard",
      "keyboard-custom-layout",
      "voice",
      "speech-recognition"
    ],

    "app-store": [
      "network",
      "storage",
      "app-management",
      "notifications"
    ],

    "developer": [
      "developer",
      "system-diagnostics",
      "storage"
    ],

    "terminal": [
      "developer",
      "storage"
    ]

  },

  "riskLevels": {
    "normal": {
      "requiresConfirmation": false
    },

    "high": {
      "requiresConfirmation": true
    },

    "critical": {
      "requiresConfirmation": true,
      "requiresDeveloperMode": true
    }
  },

  "rules": {
    "unknownPermissionsDenied": true,
    "unknownAppsDenied": true,
    "unknownModulesDenied": true,
    "criticalPermissionsRequireDeveloperMode": true,
    "permissionChangesAreLogged": true,
    "revokedPermissionsTakeEffectImmediately": true
  }

}