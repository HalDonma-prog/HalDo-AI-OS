/* =====================================
   HALDO AI OS 6.0 STABLE
   MAIN DESIGN SYSTEM
===================================== */


* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}


:root {

    --haldo-blue: #00aaff;
    --haldo-dark: #050914;
    --haldo-card: rgba(255,255,255,0.08);
    --haldo-border: rgba(255,255,255,0.15);
    --haldo-text: #ffffff;

}


body {

    min-height: 100vh;

    font-family:
    "Segoe UI",
    Arial,
    sans-serif;

    background:
    radial-gradient(
        circle at top,
        #123c70,
        var(--haldo-dark)
    );

    color: var(--haldo-text);

}


/* =====================
   BOOT SCREEN
===================== */


#boot-screen {

    position: fixed;

    inset: 0;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    background:

    radial-gradient(
        circle,
        #0066aa,
        #02040a
    );

    z-index:9999;

}


#boot-screen h1 {

    font-size:42px;

    text-shadow:

    0 0 25px var(--haldo-blue);

}


#boot-screen p {

    margin-top:15px;

    opacity:.8;

}


/* =====================
   APP SYSTEM
===================== */


#app {

    min-height:100vh;

}


.hidden {

    display:none;

}


/* =====================
   HEADER
===================== */


.header {

    padding:30px;

    text-align:center;

    background:

    var(--haldo-card);

    backdrop-filter:blur(20px);

    border-bottom:

    1px solid var(--haldo-border);

}


.header h1 {

    font-size:34px;

}



/* =====================
   NAVIGATION
===================== */


.navigation {

    display:flex;

    flex-wrap:wrap;

    justify-content:center;

    gap:12px;

    padding:20px;

}



.navigation button {

    padding:14px 20px;

    border:none;

    border-radius:15px;

    cursor:pointer;

    color:white;

    background:

    rgba(0,170,255,.25);

    transition:.3s;

}


.navigation button:hover {

    transform:translateY(-3px);

    box-shadow:

    0 0 20px var(--haldo-blue);

}


/* =====================
   CONTENT
===================== */


#content {

    padding:30px;

}


.welcome {

    max-width:800px;

    margin:auto;

    padding:35px;

    border-radius:25px;

    background:

    var(--haldo-card);

    backdrop-filter:blur(20px);

    border:

    1px solid var(--haldo-border);

}


.welcome h2 {

    margin-bottom:20px;

    font-size:30px;

}


.welcome p {

    margin-top:12px;

    line-height:1.6;

}



/* =====================
   MOBILE
===================== */


@media(max-width:600px){

    .header h1 {

        font-size:24px;

    }


    .navigation {

        flex-direction:column;

    }


    .navigation button {

        width:100%;

    }


    #content {

        padding:15px;

    }

}