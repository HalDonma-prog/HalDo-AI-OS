/* =====================================
   HALDO AI OS 6.0 STABLE
   MAIN DESIGN
===================================== */


* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}


body {

    min-height: 100vh;

    font-family:
    Arial,
    "Segoe UI",
    sans-serif;

    background:
    linear-gradient(
        135deg,
        #020617,
        #0f3b70
    );

    color:white;

}


/* BOOT SCREEN */


#boot-screen {

    position:fixed;

    inset:0;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    background:

    radial-gradient(
        circle,
        #0066cc,
        #020617
    );

    z-index:1000;

}



.boot-logo {

    font-size:80px;

    animation:pulse 2s infinite;

}



#boot-screen h1 {

    margin-top:20px;

    font-size:40px;

}



#boot-screen p {

    margin-top:15px;

    opacity:.8;

}



@keyframes pulse {

    50% {

        transform:scale(1.1);

    }

}




/* APP */


.hidden {

    display:none;

}



#app {

    min-height:100vh;

}



/* HEADER */


.header {

    padding:25px;

    text-align:center;

    background:

    rgba(255,255,255,.08);

    backdrop-filter:blur(15px);

}



.header h1 {

    font-size:32px;

}



.header p {

    opacity:.8;

}




/* NAVIGATION */


.navigation {

    display:flex;

    justify-content:center;

    flex-wrap:wrap;

    gap:12px;

    padding:20px;

}



.navigation button {


    padding:14px 20px;

    border:none;

    border-radius:15px;

    cursor:pointer;

    color:white;

    background:

    rgba(0,170,255,.25);


    transition:.3s;

}



.navigation button:hover {


    background:#008cff;

    transform:translateY(-3px);

}




/* CONTENT */


main {

    padding:20px;

}



.page {

    animation:show .4s;

}



@keyframes show {

    from {

        opacity:0;

        transform:translateY(20px);

    }


    to {

        opacity:1;

        transform:translateY(0);

    }

}




.card {


    margin-top:20px;

    padding:25px;

    border-radius:25px;


    background:

    rgba(255,255,255,.10);


    backdrop-filter:

    blur(20px);


    border:

    1px solid rgba(255,255,255,.15);


}



input,
textarea {


    width:100%;

    margin-top:15px;

    padding:15px;


    border:none;

    border-radius:15px;


    background:

    rgba(0,0,0,.35);


    color:white;

}



textarea {

    min-height:150px;

}




button {


    margin-top:15px;

    padding:14px 25px;

    border:none;

    border-radius:15px;

    cursor:pointer;

    background:#00aaff;

    color:white;

}




footer {


    text-align:center;

    padding:20px;

    opacity:.7;

}



/* MOBILE */


@media(max-width:600px){


.header h1 {

    font-size:24px;

}


.navigation {

    flex-direction:column;

}


.navigation button {

    width:100%;

}


}