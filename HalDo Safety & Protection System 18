(function (window, document) {

    "use strict";


    const HalDoSafety = {


        /* ==================================================
           SYSTEM
           ================================================== */

        name:
            "HalDo Safety & Protection System",

        version:
            "18.0.0",

        status:
            "ready",


        enabled:
            true,


        /* ==================================================
           SCHUTZSTUFEN
           ================================================== */

        levels: {

            NONE:
                0,

            NOTICE:
                1,

            WARNING:
                2,

            RESTRICT:
                3,

            BLOCK:
                4

        },


        /* ==================================================
           AKTUELLE SCHUTZSTUFE
           ================================================== */

        currentLevel:
            0,


        /* ==================================================
           VERHALTENSKATEGORIEN
           ================================================== */

        categories: [

            "harassment",

            "insult",

            "threat",

            "hate",

            "discrimination",

            "intimidation",

            "malicious",

            "spam",

            "abuse"

        ],


        /* ==================================================
           GRUNDSÄTZE
           ================================================== */

        principles: [

            "Respect",

            "Safety",

            "Fairness",

            "Privacy",

            "Proportionality",

            "BehaviorBasedModeration",

            "NoIdentityBasedPunishment"

        ],


        /* ==================================================
           BEISPIEL-MUSTER
           
           Diese einfache Foundation ist absichtlich
           keine vollständige KI-Moderation.
           
           Später kann ein stärkeres Moderationsmodell
           angeschlossen werden.
           ================================================== */

        patterns: {

            threat: [

                /\bich\s+(bringe|werde)\s+ dich\s+ um\b/i,

                /\bich\s+töte\s+dich\b/i,

                /\bich\s+werde\s+dich\s+töten\b/i

            ],


            harassment: [

                /\bbelästig/i,

                /\bstalking\b/i,

                /\bterrorisier/i

            ],


            insult: [

                /\bidiot\b/i,

                /\bdummkopf\b/i,

                /\barschloch\b/i

            ]

        },


        /* ==================================================
           INITIALISIERUNG
           ================================================== */

        init:
            function () {


                this.status =
                    "running";


                this.currentLevel =
                    this.levels.NONE;


                console.log(
                    "HalDo Safety System gestartet."
                );


                this.dispatch(
                    "ready"
                );


                return true;

            },


        /* ==================================================
           INHALT PRÜFEN
           ================================================== */

        analyze:
            function (
                text
            ) {


                if (
                    typeof text !==
                    "string"
                ) {


                    return {

                        safe:
                            true,

                        level:
                            this.levels.NONE,

                        categories:
                            [],

                        actions:
                            []

                    };

                }


                const result = {

                    safe:
                        true,

                    level:
                        this.levels.NONE,

                    categories:
                        [],

                    actions:
                        [],

                    message:
                        text

                };


                /*
                 * Bedrohung
                 */

                if (
                    this.matches(
                        text,
                        this.patterns.threat
                    )
                ) {


                    result.safe =
                        false;


                    result.level =
                        this.levels.BLOCK;


                    result.categories.push(
                        "threat"
                    );


                    result.actions.push(
                        "block"
                    );

                }


                /*
                 * Belästigung
                 */

                if (
                    this.matches(
                        text,
                        this.patterns.harassment
                    )
                ) {


                    result.safe =
                        false;


                    result.level =
                        Math.max(
                            result.level,
                            this.levels.RESTRICT
                        );


                    result.categories.push(
                        "harassment"
                    );


                    result.actions.push(
                        "warning"
                    );

                }


                /*
                 * Beleidigung
                 */

                if (
                    this.matches(
                        text,
                        this.patterns.insult
                    )
                ) {


                    result.safe =
                        false;


                    result.level =
                        Math.max(
                            result.level,
                            this.levels.WARNING
                        );


                    result.categories.push(
                        "insult"
                    );


                    result.actions.push(
                        "warning"
                    );

                }


                /*
                 * Ereignis
                 */

                if (
                    result.level >
                    this.levels.NONE
                ) {


                    this.currentLevel =
                        result.level;


                    this.dispatch(
                        "violation",
                        result
                    );


                }


                return result;

            },


        /* ==================================================
           REGEX-MUSTER PRÜFEN
           ================================================== */

        matches:
            function (
                text,
                patterns
            ) {


                if (
                    !Array.isArray(
                        patterns
                    )
                ) {


                    return false;

                }


                return patterns.some(
                    function (
                        pattern
                    ) {


                        return pattern.test(
                            text
                        );


                    }
                );

            },


        /* ==================================================
           AI ANTWORT PRÜFEN
           ================================================== */

        checkResponse:
            function (
                response
            ) {


                const result =
                    this.analyze(
                        response
                    );


                if (
                    !result.safe
                ) {


                    return {

                        allowed:
                            false,

                        response:
                            this.getSafeResponse(
                                result
                            ),

                        analysis:
                            result

                    };

                }


                return {

                    allowed:
                        true,

                    response:
                        response,

                    analysis:
                        result

                };

            },


        /* ==================================================
           SICHERE ANTWORT
           ================================================== */

        getSafeResponse:
            function (
                result
            ) {


                if (
                    result.categories.includes(
                        "threat"
                    )
                ) {


                    return (
                        "HalDo AI kann keine " +
                        "Bedrohungen oder schädliche " +
                        "Handlungen unterstützen."
                    );

                }


                if (
                    result.categories.includes(
                        "harassment"
                    )
                ) {


                    return (
                        "HalDo AI unterstützt keinen " +
                        "Missbrauch, keine Belästigung " +
                        "und keine Einschüchterung."
                    );

                }


                return (
                    "HalDo AI kann bei schädlichen " +
                    "oder diskriminierenden Inhalten " +
                    "nicht unterstützen."
                );

            },


        /* ==================================================
           MELDUNG ERSTELLEN
           ================================================== */

        report:
            function (
                reason,
                content
            ) {


                const report = {

                    id:
                        this.createId(),

                    reason:
                        reason || "unknown",

                    content:
                        content || "",

                    timestamp:
                        new Date().toISOString()

                };


                this.dispatch(
                    "report",
                    report
                );


                return report;

            },


        /* ==================================================
           ID ERSTELLEN
           ================================================== */

        createId:
            function () {


                return (
                    "HALDO-" +
                    Date.now() +
                    "-" +
                    Math.random()
                        .toString(36)
                        .substring(2, 9)
                );

            },


        /* ==================================================
           ACCOUNT-SCHUTZ
           
           Keine automatische Identitätsverfolgung.
           Keine heimliche Erfassung persönlicher Daten.
           
           Dieses Modul liefert nur einen Status an ein
           späteres Account-Sicherheitssystem.
           ================================================== */

        accountAction:
            function (
                level
            ) {


                switch (
                    level
                ) {


                    case this.levels.WARNING:

                        return {

                            action:
                                "warning",

                            permanent:
                                false

                        };


                    case this.levels.RESTRICT:

                        return {

                            action:
                                "temporary-restriction",

                            permanent:
                                false

                        };


                    case this.levels.BLOCK:

                        return {

                            action:
                                "account-review",

                            permanent:
                                false

                        };


                    default:

                        return {

                            action:
                                "none",

                            permanent:
                                false

                        };

                }

            },


        /* ==================================================
           STATUS
           ================================================== */

        getStatus:
            function () {


                return {

                    name:
                        this.name,

                    version:
                        this.version,

                    status:
                        this.status,

                    enabled:
                        this.enabled,

                    level:
                        this.currentLevel

                };

            },


        /* ==================================================
           AKTIVIEREN
           ================================================== */

        enable:
            function () {


                this.enabled =
                    true;


                this.dispatch(
                    "enabled"
                );


                return true;

            },


        /* ==================================================
           DEAKTIVIEREN
           
           Nur für Systemtests / Administrator-
           Konfiguration.
           ================================================== */

        disable:
            function () {


                this.enabled =
                    false;


                this.dispatch(
                    "disabled"
                );


                return true;

            },


        /* ==================================================
           EVENT SYSTEM
           ================================================== */

        dispatch:
            function (
                name,
                detail
            ) {


                try {


                    window.dispatchEvent(
                        new CustomEvent(
                            "haldo-safety-" +
                            name,
                            {
                                detail:
                                    detail || {}
                            }
                        )
                    );


                } catch (
                    error
                ) {


                    console.warn(
                        "HalDo Safety Event Fehler:",
                        error
                    );


                }

            }

    };


    /* ======================================================
       GLOBAL
       ====================================================== */

    window.HalDoSafety =
        HalDoSafety;


    /* ======================================================
       START
       ====================================================== */

    function startSafety() {


        HalDoSafety.init();


    }


    if (
        document.readyState ===
        "loading"
    ) {


        document.addEventListener(
            "DOMContentLoaded",
            startSafety,
            {
                once:
                    true
            }
        );


    } else {


        startSafety();

    }


})(window, document);