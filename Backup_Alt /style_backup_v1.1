/* =====================================
   HALDO AI OS FOUNDATION v1
   CLEAN FINAL
   STYLE PART 1/4
===================================== */


/* =====================================
   BASIC RESET
===================================== */


* {

    margin:0;
    padding:0;
    box-sizing:border-box;

}



body {

    font-family:
    "Segoe UI",
    Arial,
    sans-serif;

    background:
    radial-gradient(
        circle at top,
        #1b4f72,
        #05070d 60%
    );

    color:#ffffff;

    min-height:100vh;

    overflow-x:hidden;

}





button {

    cursor:pointer;

    border:none;

    font-family:inherit;

}





/* =====================================
   BOOT EXPERIENCE
===================================== */


.haldo-boot {

    position:fixed;

    inset:0;

    background:

    radial-gradient(
        circle,
        #123d5a,
        #02040a
    );


    display:flex;

    align-items:center;

    justify-content:center;

    z-index:9999;


}




.boot-content {

    text-align:center;

    animation:
    haldoBoot 2s ease;


}



.boot-logo img {


    width:180px;

    height:180px;

    object-fit:contain;


    filter:

    drop-shadow(
        0 0 30px #00bfff
    );


    animation:

    logoPulse 3s infinite;


}





.boot-content h1 {


    margin-top:25px;

    font-size:42px;

    letter-spacing:2px;


}




#bootMessage {


    margin-top:15px;

    color:#b8eaff;

    font-size:18px;


}




.boot-loader {


    width:260px;

    height:6px;

    background:#1b263b;

    border-radius:20px;

    margin:30px auto;

    overflow:hidden;


}




.loader-progress {


    width:60%;

    height:100%;

    background:

    linear-gradient(
        90deg,
        #00bfff,
        #7df9ff
    );


    animation:

    loading 2s infinite;


}









/* =====================================
   SYSTEM CONTAINER
===================================== */


.haldo-system {


    min-height:100vh;

    padding:20px;


}




.hidden {

    display:none;

}









/* =====================================
   HEADER
===================================== */


.haldo-header {


    display:flex;

    justify-content:space-between;

    align-items:center;


    padding:20px;


    background:

    rgba(
        255,
        255,
        255,
        0.08
    );


    backdrop-filter:blur(15px);


    border-radius:20px;


}





.brand-area {


    display:flex;

    align-items:center;

    gap:15px;


}




.brand-area img {


    width:75px;

    height:75px;

    object-fit:contain;


    filter:

    drop-shadow(
        0 0 15px #00bfff
    );


}





.system-status {


    background:

    rgba(
        0,
        255,
        150,
        .15
    );


    padding:10px 20px;

    border-radius:30px;


}









/* =====================================
   ANIMATIONS
===================================== */


@keyframes logoPulse {


    0% {

        transform:scale(1);

    }


    50% {

        transform:scale(1.08);

    }


    100% {

        transform:scale(1);

    }


}





@keyframes haldoBoot {


    from {

        opacity:0;

        transform:
        translateY(30px);

    }


    to {

        opacity:1;

        transform:
        translateY(0);

    }


}





@keyframes loading {


    from {

        transform:
        translateX(-100%);

    }


    to {

        transform:
        translateX(300%);

    }


}
/* =====================================
   HALDO AI OS FOUNDATION v1
   STYLE PART 2/4
===================================== */


/* =====================================
   DASHBOARD
===================================== */


.dashboard {


    margin-top:30px;

}



.welcome-card {


    background:

    rgba(
        255,
        255,
        255,
        0.08
    );


    backdrop-filter:

    blur(15px);


    border-radius:25px;


    padding:35px;


    text-align:center;


    box-shadow:

    0 0 40px

    rgba(
        0,
        191,
        255,
        .15
    );


}



.welcome-card h2 {


    font-size:32px;


    margin-bottom:15px;


}



.welcome-card p {


    color:#c9eaff;


    font-size:18px;


}









/* =====================================
   BUTTON DESIGN
===================================== */


button {


    background:

    linear-gradient(
        135deg,
        #00bfff,
        #0066ff
    );


    color:white;


    padding:

    12px 25px;


    border-radius:30px;


    font-size:16px;


    transition:.3s;


}





button:hover {


    transform:

    translateY(-3px);


    box-shadow:

    0 0 20px

    rgba(
        0,
        191,
        255,
        .6
    );


}









/* =====================================
   MODULE CARDS
===================================== */


.dashboard-modules {


    margin-top:40px;


}



.module-grid {


    display:grid;


    grid-template-columns:

    repeat(
        auto-fit,
        minmax(
            220px,
            1fr
        )
    );


    gap:25px;


}





.module-card {


    background:

    rgba(
        255,
        255,
        255,
        .08
    );


    backdrop-filter:

    blur(20px);


    border-radius:25px;


    padding:30px;


    text-align:center;


    border:

    1px solid

    rgba(
        255,
        255,
        255,
        .12
    );


    transition:.3s;


}





.module-card:hover {


    transform:

    translateY(-8px);


    box-shadow:

    0 0 35px

    rgba(
        0,
        191,
        255,
        .25
    );


}




.module-symbol {


    font-size:45px;


    margin-bottom:15px;


}









/* =====================================
   CHAT AREA
===================================== */


.chat-section {


    margin-top:40px;


    background:

    rgba(
        255,
        255,
        255,
        .06
    );


    border-radius:25px;


    padding:25px;


}





.chat-title {


    margin-bottom:20px;


}





.chat-messages {


    height:300px;


    overflow-y:auto;


    padding:15px;


}





.ai-message {


    background:

    rgba(
        0,
        191,
        255,
        .18
    );


    padding:15px;


    border-radius:20px;


    margin-bottom:15px;


    max-width:80%;


}





.user-message {


    background:

    rgba(
        255,
        255,
        255,
        .12
    );


    padding:15px;


    border-radius:20px;


    margin-left:auto;


    margin-bottom:15px;


    max-width:80%;


}









/* =====================================
   CHAT INPUT
===================================== */


.chat-input-area {


    display:flex;


    gap:10px;


    margin-top:20px;


}





.chat-input-area input {


    flex:1;


    padding:15px;


    border-radius:25px;


    border:none;


    outline:none;


    background:

    rgba(
        255,
        255,
        255,
        .12
    );


    color:white;


    font-size:16px;


}
/* =====================================
   HALDO AI OS FOUNDATION v1
   STYLE PART 3/4
===================================== */


/* =====================================
   SYSTEM MODULES
===================================== */


.system-module {


    margin-top:35px;


    background:

    rgba(
        255,
        255,
        255,
        .07
    );


    backdrop-filter:

    blur(15px);


    border-radius:25px;


    padding:25px;


}





.system-module h2 {


    margin-bottom:20px;


    color:#dff7ff;


}









/* =====================================
   MODULE PANEL
===================================== */


.module-panel {


    background:

    rgba(
        0,
        0,
        0,
        .18
    );


    border-radius:20px;


    padding:25px;


}





.module-panel input[type="file"] {


    color:white;


    padding:10px;


}





.module-panel textarea {


    width:100%;


    min-height:180px;


    resize:vertical;


    border:none;


    outline:none;


    border-radius:20px;


    padding:20px;


    background:

    rgba(
        255,
        255,
        255,
        .12
    );


    color:white;


    font-size:16px;


}









/* =====================================
   SETTINGS
===================================== */


.setting-item {


    display:flex;


    justify-content:space-between;


    align-items:center;


    padding:18px;


    margin-bottom:15px;


    border-radius:20px;


    background:

    rgba(
        255,
        255,
        255,
        .08
    );


}





.setting-item span {


    font-size:18px;


}









/* =====================================
   STATUS PANEL
===================================== */


.system-status-panel {


    margin-top:35px;


    padding:25px;


}





.status-card {


    background:

    rgba(
        255,
        255,
        255,
        .08
    );


    padding:25px;


    border-radius:25px;


}





.online {


    color:#00ff99;


}









/* =====================================
   DARK MODE SUPPORT
===================================== */


body.dark-mode {


    background:

    radial-gradient(
        circle at top,
        #000814,
        #000000
    );


}





body.dark-mode .module-card,

body.dark-mode .welcome-card,

body.dark-mode .chat-section,

body.dark-mode .system-module {


    background:

    rgba(
        0,
        0,
        0,
        .35
    );


}









/* =====================================
   MOBILE OPTIMIZATION
===================================== */


@media(max-width:768px){



    .haldo-header {


        flex-direction:column;


        gap:20px;


        text-align:center;


    }





    .brand-area {


        flex-direction:column;


    }





    .module-grid {


        grid-template-columns:1fr;


    }





    .chat-input-area {


        flex-direction:column;


    }





    .chat-input-area button {


        width:100%;


    }





    .welcome-card {


        padding:25px;


    }





    .boot-logo img {


        width:130px;


        height:130px;


    }



}
/* =====================================
   HALDO AI OS FOUNDATION v1
   STYLE PART 4/4 FINAL
===================================== */


/* =====================================
   NOTIFICATION CENTER
===================================== */


.notification-center {


    margin-top:35px;


    padding:25px;


    background:

    rgba(
        255,
        255,
        255,
        .08
    );


    backdrop-filter:

    blur(20px);


    border-radius:25px;


}




.notification-center h2 {


    margin-bottom:20px;


}





#notificationArea {


    padding:20px;


    border-radius:20px;


    background:

    rgba(
        0,
        0,
        0,
        .15
    );


    color:#cfefff;


}









/* =====================================
   FUTURE MODULES
===================================== */


.future-modules {


    margin-top:40px;


}





.future-grid {


    display:grid;


    grid-template-columns:

    repeat(
        auto-fit,
        minmax(
            200px,
            1fr
        )
    );


    gap:25px;


}





.future-card {


    background:

    rgba(
        255,
        255,
        255,
        .08
    );


    border-radius:25px;


    padding:25px;


    text-align:center;


    transition:.4s;


    border:

    1px solid

    rgba(
        255,
        255,
        255,
        .1
    );


}





.future-card:hover {


    transform:

    translateY(-10px)
    scale(1.03);


    box-shadow:

    0 0 35px

    rgba(
        0,
        191,
        255,
        .3
    );


}





.future-card:first-letter {


    font-size:35px;


}









/* =====================================
   SYSTEM CONNECTION AREA
===================================== */


#haldoSystemConnection {


    margin-top:40px;


    min-height:80px;


    border-radius:25px;


    background:

    rgba(
        0,
        0,
        0,
        .15
    );


}









/* =====================================
   FOOTER BRANDING
===================================== */


.haldo-footer {


    margin-top:50px;


    padding:30px;


    text-align:center;


    background:

    rgba(
        255,
        255,
        255,
        .06
    );


    border-radius:25px;


    color:#cfefff;


}





.footer-brand {


    display:flex;


    justify-content:center;


    align-items:center;


    gap:15px;


}





.footer-brand img {


    width:60px;


    filter:

    drop-shadow(
        0 0 15px #00bfff
    );


}









/* =====================================
   PREMIUM ANIMATIONS
===================================== */


.module-card,

.future-card,

.welcome-card {


    animation:

    fadeUp .8s ease;


}





@keyframes fadeUp {


    from {


        opacity:0;


        transform:

        translateY(30px);


    }



    to {


        opacity:1;


        transform:

        translateY(0);


    }


}









@keyframes glow {


    0% {


        box-shadow:

        0 0 10px #00bfff;


    }


    50% {


        box-shadow:

        0 0 35px #00bfff;


    }


    100% {


        box-shadow:

        0 0 10px #00bfff;


    }


}









/* =====================================
   SCROLL DESIGN
===================================== */


::-webkit-scrollbar {


    width:10px;


}





::-webkit-scrollbar-track {


    background:#05070d;


}





::-webkit-scrollbar-thumb {


    background:

    linear-gradient(
        #00bfff,
        #0066ff
    );


    border-radius:20px;


}









/* =====================================
   FOUNDATION v1 COMPLETE
===================================== */