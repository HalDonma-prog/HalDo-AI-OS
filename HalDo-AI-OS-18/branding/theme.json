{
    "system": {
        "name": "HalDo AI OS",
        "version": "18.0.0",
        "edition": "Professional Ultimate Foundation"
    },

    "interface": {
        "style": "glassmorphism",
        "animation": true,
        "roundedCorners": true,
        "blur": true,
        "glowEffects": true
    },

    "colors": {
        "background": "#090d18",
        "surface": "rgba(255,255,255,0.12)",
        "primary": "#4da6ff",
        "secondary": "#8b5cff",
        "accent": "#00e5ff",
        "text": "#ffffff"
    },

    "logo": {
        "enabled": true,
        "shape": "round",
        "glow": true,
        "animation": true,
        "path": "assets/logo/logo.svg"
    },

    "startup": {
        "showLogo": true,
        "showLoading": true,
        "showWelcome": true,
        "loadingText": "HalDo AI OS wird gestartet..."
    },

    "desktop": {
        "wallpaper": "default",
        "widgets": true,
        "notifications": true
    },

    "language": {
        "default": "de",
        "multiLanguage": true
    }
}